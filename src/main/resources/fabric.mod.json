{
  "schemaVersion": 1,
  "id": "create",
  "version": "${version}",
  "name": "Create Fly (Unofficial 26.3 Port)",
  "description": "Unofficial port of Create Fly (ZurrTum's Fabric port of Create) to Minecraft 26.3, with bug fixes. Not made or supported by the Create or Create Fly teams: please report problems with this build on its CurseForge page or GitHub issues, not upstream.",
  "authors": [
    "zedekvdb (26.3 port)"
  ],
  "contributors": [
    "ZurrTum (Create Fly)",
    "simibubi and the Create team (Create)"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/create-fly-unofficial-port",
    "sources": "https://github.com/zedekvdb/create-fly-unofficial-port",
    "issues": "https://github.com/zedekvdb/create-fly-unofficial-port/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.zurrtum.create.Create"
    ],
    "client": [
      "com.zurrtum.create.client.Create"
    ],
    "create_plugin": [
      "com.zurrtum.create.AllEarlyRegistries"
    ],
    "jei_mod_plugin": [
      "com.zurrtum.create.client.compat.jei.JeiClientPlugin"
    ],
    "rrv_client": [
      "com.zurrtum.create.client.compat.rrv.RrvClientPlugin"
    ]
  },
  "accessWidener": "create.classtweaker",
  "mixins": [
    "create.mixins.json",
    {
      "config": "create.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": ">=26.3- <26.4-",
    "java": ">=25"
  },
  "breaks": {
    "fabric-api": "<0.152.0"
  }
}
